rules_version = '2';
// LE Sales — Firestore security rules.
// Data lives at /teams/{teamCode}/records/{id}. The team code is a private string (min 8 chars)
// typed into each phone and the owner panel; it is never stored in the public website code.
// Every request must come from a signed-in (anonymous) Firebase user of this project.
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{team}/records/{id} {
      allow get, list: if request.auth != null && team.size() >= 8;
      allow create, update: if request.auth != null && team.size() >= 8
        && request.resource.data.id == id
        && request.resource.data.kind in ['visit', 'quote', 'order', 'payment']
        && request.resource.data.rep is string && request.resource.data.rep.size() <= 60
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.size() <= 40;
      allow delete: if false;   // the app soft-deletes (deleted: true) so history is kept
    }
    // nothing else is readable or writable; /teams itself cannot be listed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
